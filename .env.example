# Copier ce fichier en .env.local et renseigner les valeurs.
# .env.local est ignoré par git : ne jamais y mettre de secret dans un fichier versionné.

# Chaîne de connexion Postgres de la branche Neon « dev » (console Neon > Connection Details).
# En production et en preview, Vercel injecte DATABASE_URL via l'intégration Neon.
DATABASE_URL=postgresql://utilisateur:mot-de-passe@hote.neon.tech/neondb?sslmode=require
