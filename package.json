{
  "name": "angular-audio-ecommerce-app",
  "version": "0.0.0",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.cjs",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "json-server": "json-server --watch server/db.json",
    "test": "ng test",
    "lint": "ng lint",
    "test:api": "vitest run --config vitest.api.config.ts",
    "typecheck:api": "tsc --noEmit -p api/tsconfig.json",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@neondatabase/serverless": "^1.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vercel/node": "^24.0.2",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.3",
    "json-server": "^1.0.0-beta.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.5"
  }
}
